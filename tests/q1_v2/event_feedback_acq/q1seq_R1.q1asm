acquisitions={'measurements': {'index': 0, 'num_bins': 2}}

seq_prog="""
#  R0: _zero
#  R1: Rs._acq_measurements
#  R2: _repetitions
# --INIT-- 
    move           0,R0       # L0001 R0: _zero
    move           2,R2       # L0002 R2: _repetitions
    move           0,R1       # L0003 R1: Rs._acq_measurements
    wait_sync      100        # L0004 t=0
# --START-- (t=0) 
_start:
    reset_ph                  # L0005 @ 0
    upd_param      4          # L0006 t=0
    fb_acq_tb_id   20,4       # L0007 t=4
    fb_acq_iq_id   21,154     # L0008 t=8
# acquire(measurements, increment) 
    acquire        0,R1,670   # L0009 t=162
    add            R1,1,R1    # L0010 
# --END-- 
    sub            R2,1,R2    # L0011 
    jg             @_start    # L0012 
    upd_param      4          # L0013 t=832
    stop                      # L0014 
"""

