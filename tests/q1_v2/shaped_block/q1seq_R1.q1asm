acquisitions={}

seq_prog="""
# --INIT-- 
           move           0,R0       # L0001 R0: _zero
           move           2,R1       # L0002 R1: _repetitions
           wait_sync      100        # L0003 t=0
# --START-- (t=0) 
_start:    reset_ph                  # L0004 @ 0
# R.wait:int = 20 
           move           20,R2      # L0005 R2: R.wait
# loop_range(0, 4, 1):R._var0 t=0 
           move           0,R3       # L0006 R3: R._var0
           move           4,R4       # L0007 R4: R._cnt0
loop_0:    upd_param      180        # L0008 t=0
# wait(R.wait) t=180 
           move           R2,R5      # L0009 R5: _waittime
#          --- check for negative wait time 
           nop                       # L0010  cmp wait for R5
           cmp            R5,4       # L0011 
           jge            @waitc1    # L0012 
           illegal                   # L0013 wait time < 4 ns
waitc1:    cmp            R5,65535   # L0014 
           jle            @endwait1  # L0015 
wait1:     sub            R5,65532,R5 # L0016 
           wait           65532      # L0017 
           cmp            R5,65535   # L0018 
           jg             @wait1     # L0019 
endwait1:  wait           R5         # L0020 
# endloop t=180 
           add            R3,1,R3    # L0021 
           sub            R4,1,R4    # L0022 
           jg             @loop_0    # L0023 
# --END-- 
           sub            R1,1,R1    # L0024 
           jg             @_start    # L0025 
           upd_param      4          # L0026 t=180
           stop                      # L0027 
"""

