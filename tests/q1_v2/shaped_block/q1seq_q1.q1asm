seq_prog="""
# --INIT-- 
           move           0,R0       # L0001 R0: _zero
           move           2,R1       # L0002 R1: _repetitions
           wait_sync      100        # L0003 t=0
# --START-- (t=0) 
_start:    reset_ph                  # L0004 @ 0
# R.wait:int = 20 
           move           20,R2      # L0005 R2: R.wait
# loop_range(0, 4, 1):R._var0 t=0 
           move           0,R3       # L0006 R3: R._var0
           move           4,R4       # L0007 R4: R._cnt0
# shaped_pulse(block80, 0.5, block80, 0.5) 
# awg_gain = 0.5, 0.5 t=0 
loop_0:    set_awg_gain   16383,16383 # L0008 @ 0
# play block80 block80 t=0 
           play           0,0,180    # L0009 t=0
# wait(R.wait) t=180 
           move           R2,R5      # L0010 R5: _waittime
#          --- check for negative wait time 
           nop                       # L0011  cmp wait for R5
           cmp            R5,4       # L0012 
           jge            @waitc1    # L0013 
           illegal                   # L0014 wait time < 4 ns
waitc1:    cmp            R5,65535   # L0015 
           jle            @endwait1  # L0016 
wait1:     sub            R5,65532,R5 # L0017 
           wait           65532      # L0018 
           cmp            R5,65535   # L0019 
           jg             @wait1     # L0020 
endwait1:  wait           R5         # L0021 
# endloop t=180 
           add            R3,1,R3    # L0022 
           sub            R4,1,R4    # L0023 
           jg             @loop_0    # L0024 
# --END-- 
           sub            R1,1,R1    # L0025 
           jg             @_start    # L0026 
           upd_param      4          # L0027 t=180
           stop                      # L0028 
"""

