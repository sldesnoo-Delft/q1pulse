seq_prog="""
#  R30: R.a
#  R31: R.b
#  R32: R.c
#  R33: R.d
#  R0: _zero
# --INIT-- 
           move           0,R0       # L0001 R0: _zero
# var R.a:int 
# var R.b:int 
# var R.c:int 
# var R.d:int 
           wait_sync      100        # L0002 t=0
# --START-- (t=0) 
_start:    reset_ph                  # L0003 @ 0
           upd_param      100        # L0004 t=0
# awg_offset = 0.0, None t=100 
           set_awg_offs   0,0        # L0005 @ 100
           upd_param      4          # L0006 t=100
# R.d:int = 0 
           move           0,R33      # L0007 R33: R.d
# R.c:int = 1 
           move           1,R32      # L0008 
# # if-block t=100 
# condition R.a > R.b, endif1 
           cmp            R30,R31    # L0009 
           jbe            @endif1    # L0010 
# branch start time: 100 
           move           10,R32     # L0011 
# branch end time: 100 
# # if-block t=100 
# condition R.a == R.b, cont3 
endif1:    cmp            R30,R31    # L0012 
           jnz            @cont3     # L0013 
# branch start time: 100 
           move           2,R33      # L0014 
# block_pulse(100, 0.2, None) 
           set_awg_offs   6553,0     # L0015 @ 110
           wait           10         # L0016 
           upd_param      100        # L0017 t=110
           set_awg_offs   0,0        # L0018 @ 210
           upd_param      20         # L0019 t=210
# branch end time: 210 
           jmp            @endif2    # L0020 
# condition R.a < R.b, cont4 
cont3:     cmp            R30,R31    # L0021 
           jae            @cont4     # L0022 
# branch start time: 100 
           move           3,R33      # L0023 
# block_pulse(10, 0.4, None) 
           set_awg_offs   13107,0    # L0024 @ 120
           upd_param      10         # L0025 t=120
           set_awg_offs   0,0        # L0026 @ 130
           upd_param      80         # L0027 t=130
# branch end time: 130 
           jmp            @endif2    # L0028 
# condition None, endif2 
# branch start time: 100 
cont4:     move           4,R33      # L0029 
# block_pulse(80, 0.6, None) 
           set_awg_offs   19660,0    # L0030 @ 110
           wait           10         # L0031 
           upd_param      80         # L0032 t=110
           set_awg_offs   0,0        # L0033 @ 190
           upd_param      20         # L0034 t=190
# branch end time: 190 
endif2:    wait           10         # L0035 
# --END-- 
           stop                      # L0036 
"""

