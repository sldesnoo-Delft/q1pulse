waveforms={
    }

weights={
    }

acquisitions={}

seq_prog="""
#  R30: R.a
#  R31: R.b
#  R32: R.c
#  R33: R.d
#  R0: _zero
# --INIT-- 
    move           0,R0       # L0001 R0: _zero
# var R.a:int 
# var R.b:int 
# var R.c:int 
# var R.d:int 
    wait_sync      100        # L0002 t=0
# --START-- (t=0) 
_start:
    reset_ph                  # L0003 @ 0
    upd_param      100        # L0004 t=0
# awg_offset = 0.0, None t=100 
    set_awg_offs   0,0        # L0005 @ 100
# R.d:int = 0 
    move           0,R33      # L0006 R33: R.d
# R.c:int = 1 
    move           1,R32      # L0007 
# if-block 1 branches (t = 100 ... 100) 
# condition R.a > R.b 
    cmp            R30,R31    # L0008 
    jbe            @endif1    # L0009 
# R.c:int = 10 
    move           10,R32     # L0010 
endif1:
# if-block 3 branches (t = 100 ... 210) 
# condition R.a == R.b 
    cmp            R30,R31    # L0011 
    jnz            @cont4     # L0012 
    upd_param      10         # L0013 t=100
# R.d:int = 2 
    move           2,R33      # L0014 
# block_pulse(100, 0.2, None) 
# awg_offset = 0.2, None t=110 
    set_awg_offs   6553,0     # L0015 @ 110
    upd_param      100        # L0016 t=110
# awg_offset = 0.0, None t=210 
    set_awg_offs   0,0        # L0017 @ 210
    jmp            @endif3    # L0018 
cont4:
# condition R.a < R.b 
    cmp            R30,R31    # L0019 
    jae            @cont5     # L0020 
    upd_param      20         # L0021 t=100
# R.d:int = 3 
    move           3,R33      # L0022 
# block_pulse(10, 0.4, None) 
# awg_offset = 0.4, None t=120 
    set_awg_offs   13107,0    # L0023 @ 120
    upd_param      10         # L0024 t=120
# awg_offset = 0.0, None t=130 
    set_awg_offs   0,0        # L0025 @ 130
    upd_param      80         # L0026 t=130
    jmp            @endif3    # L0027 
cont5:
# condition None 
    upd_param      10         # L0028 t=100
# R.d:int = 4 
    move           4,R33      # L0029 
# block_pulse(80, 0.6, None) 
# awg_offset = 0.6, None t=110 
    set_awg_offs   19660,0    # L0030 @ 110
    upd_param      80         # L0031 t=110
# awg_offset = 0.0, None t=190 
    set_awg_offs   0,0        # L0032 @ 190
    upd_param      20         # L0033 t=190
endif3:
    upd_param      10         # L0034 t=210
# --END-- 
    stop                      # L0035 
"""

