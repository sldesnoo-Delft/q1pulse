acquisitions={}

seq_prog="""
# --INIT-- 
           move           0,R0       # L0001 R0: _zero
           move           3,R1       # L0002 R1: _repetitions
           wait_sync      100        # L0003 t=0
# --START-- (t=0) 
_start:    reset_ph                  # L0004 @ 0
           upd_param      200        # L0005 t=0
# loop_range(20, 100, 20):R._var0 t=200 
           move           20,R2      # L0006 R2: R._var0
           move           4,R3       # L0007 R3: R._cnt0
loop_0:    upd_param      20         # L0008 t=200
# wait(R._var0) t=220 
           move           R2,R4      # L0009 R4: _waittime
#          --- check for negative wait time 
           nop                       # L0010  cmp wait for R4
           cmp            R4,4       # L0011 
           jge            @waitc1    # L0012 
           illegal                   # L0013 wait time < 4 ns
waitc1:    cmp            R4,65535   # L0014 
           jle            @endwait1  # L0015 
wait1:     sub            R4,65532,R4 # L0016 
           wait           65532      # L0017 
           cmp            R4,65535   # L0018 
           jg             @wait1     # L0019 
endwait1:  wait           R4         # L0020 
# block_pulse(20, 0.6, None) 
# awg_offset = 0.6, None t=220 
           set_awg_offs   19660,0    # L0021 @ 220
           upd_param      20         # L0022 t=220
# awg_offset = 0.0, None t=240 
           set_awg_offs   0,0        # L0023 @ 240
           upd_param      200        # L0024 t=240
# endloop t=440 
           add            R2,20,R2   # L0025 
           sub            R3,1,R3    # L0026 
           jg             @loop_0    # L0027 
# loop_range(-2, 2, 1):R._var1 t=440 
           move           4294967294,R2 # L0028 R2: R._var1
           move           4,R3       # L0029 R3: R._cnt1
loop_1:    upd_param      120        # L0030 t=440
# endloop t=560 
           add            R2,1,R2    # L0031 
           sub            R3,1,R3    # L0032 
           jg             @loop_1    # L0033 
           upd_param      100        # L0034 t=560
# loop_range(80, 0, -20):R._var2 t=660 
           move           80,R2      # L0035 R2: R._var2
           move           5,R3       # L0036 R3: R._cnt2
loop_2:    upd_param      20         # L0037 t=660
# wait(R._var2 + 20) t=680 
           add            R2,20,R4   # L0038 temp R4
           nop                       # L0039  move wait for R4
           move           R4,R5      # L0040 R5: _waittime
#          --- check for negative wait time 
           nop                       # L0041  cmp wait for R5
           cmp            R5,4       # L0042 
           jge            @waitc2    # L0043 
           illegal                   # L0044 wait time < 4 ns
waitc2:    cmp            R5,65535   # L0045 
           jle            @endwait2  # L0046 
wait2:     sub            R5,65532,R5 # L0047 
           wait           65532      # L0048 
           cmp            R5,65535   # L0049 
           jg             @wait2     # L0050 
endwait2:  wait           R5         # L0051 
# endloop t=680 
           add            R2,4294967276,R2 # L0052 
           sub            R3,1,R3    # L0053 
           jg             @loop_2    # L0054 
# --END-- 
           sub            R1,1,R1    # L0055 
           jg             @_start    # L0056 
           upd_param      4          # L0057 t=680
           stop                      # L0058 
"""

