acquisitions={}

seq_prog="""
# --INIT-- 
           move           0,R0       # L0001 R0: _zero
           move           2,R1       # L0002 R1: _repetitions
           wait_sync      100        # L0003 t=0
# --START-- (t=0) 
_start:    reset_ph                  # L0004 @ 0
           move           100,R2     # L0005 R2: R._var0
           move           20,R3      # L0006 R3: R._cnt0
loop_0:    upd_param      220        # L0007 t=0
           move           R2,R4      # L0008 R4: _waittime
#          --- check for negative wait time 
           nop                       # L0009  cmp wait for R4
           cmp            R4,4       # L0010 
           jge            @waitc1    # L0011 
           illegal                   # L0012 wait time < 4 ns
waitc1:    cmp            R4,65535   # L0013 
           jle            @endwait1  # L0014 
wait1:     sub            R4,65532,R4 # L0015 
           wait           65532      # L0016 
           cmp            R4,65535   # L0017 
           jg             @wait1     # L0018 
endwait1:  wait           R4         # L0019 
# block_pulse(600, 0.1, None) 
           set_awg_offs   3276,0     # L0020 @ 420
           wait           200        # L0021 
           upd_param      600        # L0022 t=420
           set_awg_offs   0,0        # L0023 @ 1020
           upd_param      1400       # L0024 t=1020
           add            R2,100,R2  # L0025 
           sub            R3,1,R3    # L0026 
           jg             @loop_0    # L0027 
# --END-- 
           sub            R1,1,R1    # L0028 
           jg             @_start    # L0029 
           upd_param      4          # L0030 t=2420
           stop                      # L0031 
"""

