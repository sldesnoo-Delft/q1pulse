waveforms={
    }

weights={
    }

acquisitions={}

seq_prog="""
#  R30: R.a
#  R31: R.b
#  R32: R.c
#  R33: R.d
#  R0: _zero
# --INIT-- 
    move           0,R0       # L0001 R0: _zero
# var R.a:int 
# var R.b:int 
# var R.c:int 
# var R.d:int 
    wait_sync      100        # L0002 t=0
# --START-- (t=0) 
_start:
    reset_ph                  # L0003 @ 0
    upd_param      1000       # L0004 t=0
# awg_offset = 0.0, None t=1000 
    set_awg_offs   0,0        # L0005 @ 1000
    upd_param      4          # L0006 t=1000
# R.d:int = 0 
    move           0,R33      # L0007 R33: R.d
# R.c:int = 1 
    move           1,R32      # L0008 
# R.c:int = R.a > R.b 
    cmp            R30,R31    # L0009 
    move           0,R32      # L0010 
    jbe            @cmove1    # L0011 
    move           1,R32      # L0012 
cmove1:
# R.d:int = R.a > R.b & R.a > R.c 
    cmp            R30,R31    # L0013 
    move           0,R1       # L0014 temp R1
    jbe            @cmove2    # L0015 
    move           1,R1       # L0016 
cmove2:
    cmp            R30,R32    # L0017 
    move           0,R2       # L0018 temp R2
    jbe            @cmove3    # L0019 
    move           1,R2       # L0020 
cmove3:
    nop                       # L0021  and wait for R2
    and            R1,R2,R33  # L0022 
# --END-- 
    stop                      # L0023 
"""

