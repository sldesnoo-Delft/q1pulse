# awg_gain = 0.0, -0.25 t=240 
           set_awg_gain   0,-8192    # L0009 @ 240
# awg_offset = 0.0, 0.25 t=240 
# -- Overwrites set_awg_offs at 240 -- 
           set_awg_offs   0,8191     # L0010 @ 240
# play _ramp_40 _ramp_40 t=240 
           play           0,0,40     # L0011 t=240
# awg_offset = 0.0, 0.0 t=280 
           set_awg_offs   0,0        # L0012 @ 280
# ramp_2paths(800, 0.0, 0.0, 0.0, 0.25) 
# Rs._ramp_offset0:float = 0.0 
           move           0,R1       # L0013 R1: Rs._ramp_offset0
# Rs._ramp_offset1:float = 0.0 
           move           0,R2       # L0014 R2: Rs._ramp_offset1
# awg_gain = 0.0, 0.0325 t=280 
           set_awg_gain   0,1064     # L0015 @ 280
# repeat(8): t=280 
           move           8,R3       # L0016 R3: Rs._cnt0
# awg_offset = Rs._ramp_offset0, Rs._ramp_offset1 t=280 
local_0:   asr            R1,16,R4   # L0017 temp R4
           asr            R2,16,R5   # L0018 temp R5
           nop                       # L0019  set_awg_offs wait for R5
           set_awg_offs   R4,R5      # L0020 @ 280
