           move           536870911,R2 # L0030 
# awg_gain = 0.0, -0.03170731707317073 t=1280 
           set_awg_gain   0,-1039    # L0031 @ 1280
# repeat(8): t=1280 
           move           8,R3       # L0032 R3: Rs._cnt1
# awg_offset = Rs._ramp_offset0, Rs._ramp_offset1 t=1280 
local_1:   asr            R1,16,R4   # L0033 temp R4
           asr            R2,16,R5   # L0034 temp R5
           nop                       # L0035  set_awg_offs wait for R5
           set_awg_offs   R4,R5      # L0036 @ 1280
