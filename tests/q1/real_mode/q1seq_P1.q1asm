# -- Overwrites set_awg_offs at 40 -- 
           set_awg_offs   3276,8191  # L0007 @ 40
           upd_param      200        # L0008 t=40
# awg_offset = 0.0, None t=240 
# ------:  set_awg_offs   0,0        # @ 240 = overwritten =
